{
  "dashboard": {
    "title": "Transcendence - API Backend",
    "uid": "backend-metrics",
    "tags": ["transcendence", "backend"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Requêtes HTTP Totales",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(transcendence_http_requests_total[5m])",
            "legendFormat": "Requêtes"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Erreurs HTTP (4xx + 5xx)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(transcendence_http_requests_total{status=~\"[45]..\"}[5m])",
            "legendFormat": "Erreurs"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Temps Réponse Moyen",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(transcendence_http_request_duration_seconds_sum[5m]) / rate(transcendence_http_request_duration_seconds_count[5m])",
            "legendFormat": "Temps (s)"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Requêtes par Status",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(transcendence_http_requests_total[5m])",
            "legendFormat": "{{ status }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 5,
        "title": "Latence HTTP (percentiles)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(transcendence_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(transcendence_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 6,
        "title": "Connexions WebSocket Actives",
        "type": "stat",
        "targets": [
          {
            "expr": "transcendence_websocket_connections_active",
            "legendFormat": "Connexions"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 12}
      },
      {
        "id": 7,
        "title": "Requêtes Base de Données",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(transcendence_db_queries_total[5m])",
            "legendFormat": "{{ status }}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 12}
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "schemaVersion": 27,
    "version": 0
  }
}
